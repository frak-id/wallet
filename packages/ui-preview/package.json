{
    "name": "@frak-labs/ui-preview",
    "version": "0.0.12",
    "private": true,
    "type": "module",
    "license": "GNU GPL 3.0",
    "sideEffects": [
        "**/*.css",
        "**/*.css.ts"
    ],
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./components/*": "./src/*/index.tsx"
    },
    "dependencies": {
        "@frak-labs/core-sdk": "workspace:*",
        "@frak-labs/design-system": "workspace:*",
        "@vanilla-extract/css": "catalog:"
    },
    "devDependencies": {
        "@frak-labs/test-foundation": "workspace:*",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@typescript/native": "catalog:",
        "@vanilla-extract/vite-plugin": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest --watch"
    }
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Never QUERY_ALL_PACKAGES: Play policy restricts it to apps whose core
      purpose needs broad visibility.

      Both variants are listed: the wallet ships as `id.frak.wallet` in prod and
      `id.frak.wallet.dev` for the dev stage (see
      `packages/wallet-shared/src/common/utils/storeUrls.ts`).

      The manifest merger folds this into every merchant app, so
      `AppInstalledProbe` works without the merchant knowing the wallet's
      package ids.
    -->
    <queries>
        <package android:name="id.frak.wallet" />
        <package android:name="id.frak.wallet.dev" />
    </queries>

    <!-- The only permission the SDK will ever request. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      No <application> block, and deliberately no exported activity and no
      intent filter. Inbound `fCtx` handling is wired through
      `FrakConfig.deepLink` (Automatic via ActivityLifecycleCallbacks, or
      Manual via `handleReferralLink(url)`), so the merchant's own activity
      keeps owning the intent.

      `frak_data_extraction_rules.xml` and `frak_full_backup_content.xml` are
      NOT referenced from here: on `<application>`, both
      `android:dataExtractionRules` (API 31+) and `android:fullBackupContent`
      (API 24-30) are singular attributes and the manifest merger does not
      union them, so a library cannot set either on behalf of its consumer.
      Both ship as plain resources instead. Required merchant integration
      step — see "Backup and device-transfer exclusion" in the SDK's README
      for the `<application>` snippet and the `tools:replace` guidance.

      TODO: a debug-build runtime assertion that these exclusions are actually
      wired is not yet implemented.
    -->

</manifest>

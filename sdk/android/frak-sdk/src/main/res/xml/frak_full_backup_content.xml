<?xml version="1.0" encoding="utf-8"?>
<!--
  The legacy counterpart to frak_data_extraction_rules.xml, for API 24-30. Android 12 (API 31)
  replaced `android:fullBackupContent` with `android:dataExtractionRules`; below that floor this
  is the only mechanism that can keep the SDK's identity and config caches out of Auto Backup.

  Same two files, same reasoning as frak_data_extraction_rules.xml: `id.frak.sdk.xml` holds the
  anonymous identity, `id.frak.sdk.config.xml` is the resolved-config cache. Carrying either to
  a new or restored device resurrects state that belongs to a different installation.

  Same manifest-merger caveat applies: `android:fullBackupContent` is a singular attribute on
  `<application>`, so this ships as a resource for merchants to reference or copy — see
  AndroidManifest.xml.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="id.frak.sdk.xml" />
    <exclude
        domain="sharedpref"
        path="id.frak.sdk.config.xml" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The sheet's native chrome. Everything else the user reads comes from the
  hosted page, which owns ~45 i18n keys and the tier maths behind them.

  Names are prefixed `frak_` because a library's resources merge into the host
  app's namespace, where an unprefixed `share` would collide with the
  merchant's own. Prefixing also gives a merchant a supported way to override
  any of these: declare the same name in their app and the merger takes theirs.
-->
<resources>
    <string name="frak_sharing_title">Share and earn</string>
    <string name="frak_sharing_share">Share</string>
    <string name="frak_sharing_copy">Copy link</string>
    <string name="frak_sharing_copied">Link copied</string>
    <string name="frak_sharing_close">Close</string>
</resources>

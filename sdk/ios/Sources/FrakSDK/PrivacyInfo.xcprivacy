<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Since 1 May 2024, an SDK using a required-reason API must declare it in a privacy
  manifest or App Store Connect rejects the upload with ITMS-91053 (Missing API
  declaration). That rejection lands on the merchant's upload, not ours: shipping this
  file wrong or absent breaks every integrator's release.

  Known failure mode to validate before release: AppsFlyer's manifest failed to bundle
  correctly in the static SPM variant (their issue #281). Propagation must be checked
  against a real consumer app, not just a local `swift build`.
-->
<plist version="1.0">
<dict>
    <!--
      No tracking as defined by App Tracking Transparency: nothing here is joined with
      data from other companies' apps or sites, and no data goes to a data broker. The
      ATT question needs a legal decision before iOS ships; if that decision changes,
      this key, NSPrivacyTrackingDomains, and the NSPrivacyCollectedDataTypeTracking
      flags below all change with it.
    -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!--
          The anonymous id. Apple's "Device ID" covers any identifier scoped to a
          particular device, browser or app installation, which is exactly what this
          is: derived from a P-256 keypair the platform holds, one per installation,
          gone on uninstall.

          Linked, because the whole point of the install handoff is that the wallet
          links this id to the user's Frak identity. Declaring it unlinked would be
          false the moment `openFrakApp()` succeeds.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <!--
          `trackPurchase(customerId:orderId:token:)` transmits the merchant's own
          customer and order identifiers plus a checkout token, so a payout can be
          reconciled. That is purchase history under Apple's taxonomy even though no
          amount or line item is sent. Over-declaring is not a rejection;
          under-declaring is.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!--
          `track(_:)` posts `arrival`, `sharing` and `custom` interactions to
          /user/track/interaction. In-app interaction events are exactly Apple's
          "Product Interaction", and this is the SDK's headline feature.

          `Interaction.custom(_:data:)` carries a merchant-supplied [String: String].
          The SDK cannot declare what a merchant chooses to put in it: that payload is
          the merchant's own declaration responsibility, and sdk/ios/README.md says so.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <!--
          `trackPurchase(customerId:...)` takes the merchant's own customer identifier.
          That is a User ID under Apple's taxonomy, distinct from the Device ID above:
          declaring it only as Purchase History would under-declare the identifier
          itself, and under-declaring is the rejection.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <!--
      UserDefaults is one of the five required-reason categories, and this SDK stores
      both the resolved merchant config and the anonymous id there. Nothing else the
      SDK touches is a required-reason API: the event queue is an ordinary file whose
      timestamps are never read, and neither WebKit nor UIPasteboard is in a category.

      CA92.1 is the right code: it covers a third-party SDK reading or writing
      UserDefaults in the app's own container, on the app's behalf, which is what this
      SDK does. C56D.1 is for an SDK that exposes a UserDefaults wrapper API for the
      app itself to call. This SDK exposes no such API, so C56D.1 would be the wrong
      declaration.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FrakSDKUI's own privacy manifest. A separate `.library` product (see Package.swift),
  so it needs its own manifest rather than inheriting FrakSDK's.

  Keep in step with Sources/FrakSDK/PrivacyInfo.xcprivacy: the collected types below
  are the subset FrakSDKUI is itself responsible for, not a copy of the full set.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!--
          SharingPageURL.build puts clientId (the anonymous id) and merchantId in the wallet
          page URL loaded in the sheet's WKWebView.

          User ID, not Device ID: the anonymous id is an installation-scoped account
          identifier, not a device-level one. Same reasoning as the core manifest, which
          carries the long version. AppFunctionality only — building a share link is what
          this module does; the reporting is declared under Product Interaction below.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- The sheet reports what the user did with the share via a `sharing` interaction. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
    </array>
    <!-- Empty: FrakSDKUI touches none of the five required-reason categories. Re-verify whenever a UIKit/Foundation call is added to this module. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
</dict>
</plist>

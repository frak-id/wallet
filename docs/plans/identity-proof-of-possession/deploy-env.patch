diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index a43f4e3f6..ec6f3ab70 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -174,6 +174,19 @@ jobs:
           fi
         env:
           STAGE: ${{ env.STAGE }}
+          # Every value below is a repository variable with its safe state as
+          # the fallback, so changing and reverting one are a settings change
+          # plus a workflow re-run — never a PR. `kubectl set env` is NOT a
+          # substitute: the next deploy reverts it.
+          # Hard-update gate. `0.0.0` = disabled.
+          MIN_VERSION_IOS: ${{ vars.MIN_VERSION_IOS || '0.0.0' }}
+          MIN_VERSION_ANDROID: ${{ vars.MIN_VERSION_ANDROID || '0.0.0' }}
+          # Credential TTLs, in seconds. The install ticket must never outlive
+          # the wallet's compiled-in store TTL (the backend clamps it), and the
+          # merge token is mirrored by native `MergeSender` — cut either only
+          # with its client.
+          INSTALL_TICKET_TTL_SECONDS: ${{ vars.INSTALL_TICKET_TTL_SECONDS || '604800' }}
+          MERGE_TOKEN_TTL_SECONDS: ${{ vars.MERGE_TOKEN_TTL_SECONDS || '3600' }}
 
       - name: "🚀 Deploy Apps"
         if: steps.changes.outputs.apps == 'true' || github.event.inputs.force_deploy == 'true'

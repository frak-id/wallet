{% assign button_class = block.settings.button_style | prepend: 'button--' %}

{% assign full_width_class = '' %}
{% if block.settings.full_width == true %}
  {% assign full_width_class = 'button--full-width' %}
{% endif %}

{% assign custom_class = '' %}
{% if block.settings.button_style == 'custom' %}
  {% assign custom_class = 'frak-share-button-custom' %}
{% endif %}

{% comment %}
  Resolution chain per text: per-block setting → translatable metaobject
  field (`frak_i18n` entry with handle `default`, managed via Translate &
  Adapt) → storefront-locale fallback. The `| t` filter is applied to the
  locale-key fallback BEFORE the `default` cascade — otherwise Liquid
  pipes the resolved value (merchant text or metaobject field) through
  `| t` and emits "Translation missing: {locale}. <text>".
{% endcomment %}
{% assign frak_i18n = shop.metaobjects.frak_i18n.default %}
{% assign button_text_fallback = 'share_btn.label' | t %}
{% assign no_reward_text_fallback = 'share_btn.no_reward' | t %}
{% assign button_text = block.settings.text | default: frak_i18n.button_share_text | default: button_text_fallback %}
{% assign no_reward_text = block.settings.no_reward_text | default: frak_i18n.button_share_no_reward_text | default: no_reward_text_fallback %}

<frak-button-share
  text="{{ button_text | escape }}"
  classname="button {{ button_class | escape }} {{ full_width_class | escape }} {{ custom_class | escape }}"
  {% if no_reward_text != blank %}no-reward-text="{{ no_reward_text | escape }}"{% endif %}
  {% if block.settings.target_interaction != blank %}target-interaction="{{ block.settings.target_interaction | escape }}"{% endif %}
  {% if request.design_mode and block.settings.enable_preview %}preview="true"{% endif %}
></frak-button-share>

{% style %}
  .frak-share-button-custom {
  background-color: {{ block.settings.background_color }};
  color: {{ block.settings.text_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Frak Sharing Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Button text",
      "info": "Leave blank to use the default text (for example \"Share and earn!\"). Add {REWARD} to show the estimated reward (for example \"Share and earn up to {REWARD}!\")."
    },
    {
      "type": "text",
      "id": "no_reward_text",
      "label": "Fallback text (no reward)",
      "info": "Shown when the button text contains {REWARD} but no reward is available. Leave blank to use the default text."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Theme editor preview"
    },
    {
      "type": "checkbox",
      "id": "enable_preview",
      "label": "Show preview in editor",
      "info": "Shows the share button in the theme editor so you can see how it looks. Clicking it does nothing in the editor.",
      "default": false
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "target_interaction",
      "label": "Reward type (advanced)",
      "info": "Leave blank unless a campaign uses a custom reward type (for example custom.customerMeeting)."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Button color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}

{% assign custom_class = '' %}
{% if block.settings.banner_style == 'custom' %}
  {% assign custom_class = 'frak-banner-custom' %}
{% endif %}

{% comment %}
  Resolution chain per text: per-block setting → translatable metaobject
  field (`frak_i18n` entry with handle `default`, managed via Translate &
  Adapt) → storefront-locale fallback. The `| t` filter is applied to the
  locale-key fallback BEFORE the `default` cascade — otherwise Liquid
  pipes the resolved value (merchant text or metaobject field) through
  `| t` and emits "Translation missing: {locale}. <text>".
{% endcomment %}
{% assign frak_i18n = shop.metaobjects.frak_i18n.default %}
{% assign referral_title_fallback = 'banner.referral.title' | t %}
{% assign referral_description_fallback = 'banner.referral.description' | t %}
{% assign referral_cta_fallback = 'banner.referral.cta' | t %}
{% assign inapp_title_fallback = 'banner.inapp.title' | t %}
{% assign inapp_description_fallback = 'banner.inapp.description' | t %}
{% assign inapp_cta_fallback = 'banner.inapp.cta' | t %}
{% assign referral_title = block.settings.referral_title | default: frak_i18n.banner_referral_title | default: referral_title_fallback %}
{% assign referral_description = block.settings.referral_description | default: frak_i18n.banner_referral_description | default: referral_description_fallback %}
{% assign referral_cta = block.settings.referral_cta | default: frak_i18n.banner_referral_cta | default: referral_cta_fallback %}
{% assign inapp_title = block.settings.inapp_title | default: frak_i18n.banner_inapp_title | default: inapp_title_fallback %}
{% assign inapp_description = block.settings.inapp_description | default: frak_i18n.banner_inapp_description | default: inapp_description_fallback %}
{% assign inapp_cta = block.settings.inapp_cta | default: frak_i18n.banner_inapp_cta | default: inapp_cta_fallback %}

<frak-banner
  classname="{{ custom_class | escape }}"
  {% if block.settings.interaction != 'default' and block.settings.interaction != blank %}interaction="{{ block.settings.interaction | escape }}"{% endif %}
  {% if referral_title != blank %}referral-title="{{ referral_title | escape }}"{% endif %}
  {% if referral_description != blank %}referral-description="{{ referral_description | escape }}"{% endif %}
  {% if referral_cta != blank %}referral-cta="{{ referral_cta | escape }}"{% endif %}
  {% if inapp_title != blank %}inapp-title="{{ inapp_title | escape }}"{% endif %}
  {% if inapp_description != blank %}inapp-description="{{ inapp_description | escape }}"{% endif %}
  {% if inapp_cta != blank %}inapp-cta="{{ inapp_cta | escape }}"{% endif %}
  {% if block.settings.image_url != blank %}image-url="{{ block.settings.image_url | image_url: width: 200 | escape }}"{% endif %}
  {% if block.settings.allow_inapp_redirect %}allow-inapp-redirect="true"{% endif %}
  {% if request.design_mode and block.settings.enable_preview %}preview="true" preview-mode="{{ block.settings.preview_mode | escape }}"{% endif %}
></frak-banner>

{% style %}
  /* Merchant-configurable colour overrides for the "custom" style preset.
     Base layout/visual CSS is shipped by <frak-banner> itself via the SDK
     (see sdk/components/src/components/Banner/Banner.css.ts). Only the
     Liquid-driven merchant customisations live here. */
  .frak-banner-custom.frak-banner {
    background-color: {{ block.settings.background_color }};
    border-color: {{ block.settings.accent_color }};
  }
  .frak-banner-custom .frak-banner__icon {
    color: {{ block.settings.accent_color }};
  }
  .frak-banner-custom .frak-banner__title {
    color: {{ block.settings.text_color }};
  }
  .frak-banner-custom .frak-banner__description {
    color: {{ block.settings.text_color }};
  }
  .frak-banner-custom .frak-banner__cta {
    background-color: {{ block.settings.cta_color }};
    border-color: {{ block.settings.cta_color }};
    color: {{ block.settings.cta_text_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Frak Banner",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Referral banner text"
    },
    {
      "type": "text",
      "id": "referral_title",
      "label": "Title",
      "info": "Leave blank to use the default text (for example \"You've been referred!\")."
    },
    {
      "type": "textarea",
      "id": "referral_description",
      "label": "Description",
      "info": "Leave blank to use the default text."
    },
    {
      "type": "text",
      "id": "referral_cta",
      "label": "Button text",
      "info": "Leave blank to use the default text (for example \"Got it\")."
    },
    {
      "type": "header",
      "content": "Banner text inside Instagram or Facebook"
    },
    {
      "type": "text",
      "id": "inapp_title",
      "label": "Title",
      "info": "Leave blank to use the default text (for example \"Open in your browser\")."
    },
    {
      "type": "textarea",
      "id": "inapp_description",
      "label": "Description",
      "info": "Leave blank to use the default text."
    },
    {
      "type": "text",
      "id": "inapp_cta",
      "label": "Button text",
      "info": "Leave blank to use the default text (for example \"Open browser\")."
    },
    {
      "type": "header",
      "content": "Open in browser prompt"
    },
    {
      "type": "checkbox",
      "id": "allow_inapp_redirect",
      "label": "Offer to open the page in the browser app",
      "info": "When on, the banner invites people who open this page inside Instagram or Facebook to open it in their phone's browser instead. Off by default. Turn it on only if this page leads customers to log in to Frak or confirm a payment, which does not work inside those apps.",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_url",
      "label": "Custom image",
      "info": "Replaces the gift icon on the left of the banner. Drag and drop an image into the Files library, or pick an existing one. Leave empty to keep the default Frak icon. Any shape works: the image is fitted in a 40×40 px square."
    },
    {
      "type": "header",
      "content": "Theme editor preview"
    },
    {
      "type": "checkbox",
      "id": "enable_preview",
      "label": "Show preview in editor",
      "info": "Shows a banner preview in the theme editor",
      "default": true
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "Preview variant",
      "info": "Choose which banner to preview in the theme editor",
      "options": [
        {
          "value": "referral",
          "label": "Referral"
        },
        {
          "value": "inapp",
          "label": "In-app browser"
        }
      ],
      "default": "referral"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "interaction",
      "label": "Reward type (advanced)",
      "info": "Choose which rewards the banner shows. Default shows the best reward available.",
      "options": [
        {
          "value": "default",
          "label": "Default (best reward)"
        },
        {
          "value": "referral",
          "label": "Referral"
        },
        {
          "value": "purchase",
          "label": "Purchase"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "banner_style",
      "label": "Banner style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Used for the border and icon",
      "default": "#3b82f6"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Button color",
      "default": "#eab308"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1e293b"
    }
  ]
}
{% endschema %}

{
  "name": "@frak-labs/nexus-listener",
  "version": "0.0.1",
  "description": "SDK iframe listener for Frak Wallet",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "type": "module",
  "license": "GNU GPL 3.0",
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "start": "bunx serve dist/ -p 3000",
    "dev": "sst dev bun dev:built",
    "dev:sandbox": "vite dev  --clearScreen false --host",
    "dev:built": "sh -c 'trap \"kill 0\" INT TERM EXIT; NODE_ENV=production bun vite build --watch & bun vite preview'",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format:check": "biome check .",
    "format": "biome check --write .",
    "bundle:check": "sst shell bunx vite-bundle-visualizer",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@frak-labs/app-essentials": "workspace:*",
    "@frak-labs/core-sdk": "workspace:*",
    "@frak-labs/design-system": "workspace:*",
    "@frak-labs/frame-connector": "workspace:*",
    "@frak-labs/wallet-shared": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@tanstack/query-async-storage-persister": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@tanstack/query-persist-client-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "preact": "catalog:",
    "react-i18next": "catalog:",
    "sonner": "catalog:",
    "viem": "catalog:",
    "wagmi": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@frak-labs/backend-elysia": "workspace:*",
    "@frak-labs/test-foundation": "workspace:*",
    "@preact/preset-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/preact": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/recipes": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "bun-types": "latest",
    "jsdom": "catalog:",
    "sst": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-mkcert": "^1.17.12",
    "vite-plugin-remove-console": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@frak-labs/nexus-wallet",
  "version": "1.0.90",
  "description": "The simple and cross-platform wallet to centralise your contents.",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "type": "module",
  "license": "GNU GPL 3.0",
  "scripts": {
    "build": "bun run build:sw && NODE_ENV=production vite build",
    "build:sw": "vite build --mode sw",
    "dev": "bun run build:sw && sst dev bun run dev:built",
    "dev:built": "sh -c 'trap \"kill 0\" INT TERM EXIT; NODE_ENV=production bun vite build --watch & bun vite preview'",
    "dev:sandbox": "bun run build:sw && vite dev  --clearScreen false --host",
    "start": "bunx serve dist -p 3000",
    "lint": "biome lint .",
    "format:check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "bundle:check": "sst shell bunx vite-bundle-visualizer",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "TARGET_ENV=local playwright test",
    "test:e2e:local": "FRAK_E2E_HOST_URL=http://localhost:3013/ TARGET_ENV=local playwright test",
    "test:e2e:dev": "TARGET_ENV=dev playwright test",
    "test:e2e:prod": "TARGET_ENV=prod playwright test",
    "test:e2e:ui": "TARGET_ENV=local playwright test --ui",
    "test:e2e:report": "TARGET_ENV=local playwright test --report show-report",
    "test:e2e:trace": "TARGET_ENV=local playwright test --report show-trace",
    "test:e2e:dev:ui": "TARGET_ENV=dev playwright test --ui",
    "test:e2e:prod:ui": "TARGET_ENV=prod playwright test --ui",
    "test:e2e:dev:codegen": "TARGET_ENV=dev playwright codegen wallet-dev.frak.id",
    "test:light": "playwright test --config playwright.light.config.ts",
    "test:light:ui": "playwright test --config playwright.light.config.ts --ui",
    "test:light:update": "playwright test --config playwright.light.config.ts --update-snapshots",
    "tauri": "tauri",
    "tauri:ios:dev": "sst dev ./scripts/tauri-dev.sh ios",
    "tauri:ios:build": "sst shell -- tauri ios build",
    "tauri:ios:build:prod": "sst shell -- tauri ios build --export-method app-store-connect",
    "tauri:ios:build:dev": "./scripts/build-ios-dev.sh",
    "tauri:android:dev": "sst dev ./scripts/tauri-dev.sh android",
    "tauri:android:build": "sst shell -- tauri android build",
    "tauri:android:build:dev": "./scripts/build-android-dev.sh",
    "tauri:version": "./scripts/sync-version.sh",
    "tauri:icons": "./src-tauri/icons/sources/regenerate.sh"
  },
  "dependencies": {
    "@frak-labs/app-essentials": "workspace:*",
    "@frak-labs/client": "workspace:*",
    "@frak-labs/core-sdk": "workspace:*",
    "@frak-labs/design-system": "workspace:*",
    "@frak-labs/frame-connector": "workspace:*",
    "@frak-labs/wallet-shared": "workspace:*",
    "@tanstack/query-async-storage-persister": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-query-persist-client": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "idb-keyval": "catalog:",
    "jose": "^6.2.4",
    "lucide-react": "catalog:",
    "ox": "catalog:",
    "permissionless": "catalog:",
    "qr": "catalog:",
    "radash": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.83.0",
    "react-i18next": "catalog:",
    "remix-utils": "^9.3.1",
    "sonner": "catalog:",
    "tauri-plugin-safe-area-insets": "^0.1.0",
    "viem": "catalog:",
    "wagmi": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@frak-labs/backend-elysia": "workspace:*",
    "@frak-labs/test-foundation": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@playwright/test": "^1.62.0",
    "@tanstack/react-router-devtools": "catalog:",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/recipes": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "bun-types": "latest",
    "cbor": "^10.0.12",
    "jsdom": "catalog:",
    "sst": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-remove-console": "catalog:",
    "vitest": "catalog:"
  }
}

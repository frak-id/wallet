{
  "name": "frak-wallet",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@pulumi/kubernetes": "^4.34.1",
    "@pulumi/pulumi": "^3.261.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^6.35.1",
    "npm-check-updates": "^19.6.6",
    "rimraf": "^6.1.3",
    "sst": "catalog:",
    "tauri-plugin-webauthn-api": "^0.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Frak ecosystem packages",
  "license": "GNU GPL 3.0",
  "packageManager": "bun@1.4.0",
  "private": true,
  "scripts": {
    "build:infra": "sst build --stage dev",
    "build:sdk": "dirs=(core legacy react components) && bun run --cwd packages/rpc build && for d in ${dirs[@]}; do bun run --cwd sdk/${d} build || exit 1; done",
    "changeset": "changeset",
    "changeset:release": "dirs=(core legacy react components) && bun run build:sdk && bun run check:es-output && bun run --cwd packages/rpc publish && bun publish --tolerate-republish --cwd packages/rpc && for d in ${dirs[@]}; do bun run --cwd sdk/${d} publish || exit 1; bun publish --tolerate-republish --cwd sdk/${d} || exit 1; done",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "check:android-manifest": "bun scripts/check-android-manifest.ts",
    "check:es-output": "bun scripts/check-es-version.ts output",
    "check:i18n-types": "bun scripts/check-i18n-types.ts",
    "check:ios-floor": "bun scripts/check-ios-floor.ts",
    "check:ios-url-scheme": "bun scripts/check-ios-url-scheme.ts",
    "check:native-versions": "bun scripts/native-version.ts check",
    "check:publishable": "bun scripts/check-publishable.ts",
    "check:safe-area": "bun scripts/check-safe-area.ts",
    "clean": "rimraf .sst/dist/ .sst/artifacts/",
    "deploy": "sst deploy --stage dev",
    "deploy:example": "sst deploy --stage example",
    "deploy:prod": "sst deploy --stage prod",
    "deploy-gcp:prod": "sst deploy --stage gcp-production",
    "deploy-gcp:staging": "sst deploy --stage gcp-staging",
    "dev": "bun sst dev",
    "dev:sandbox": "bun run --filter '*' dev:sandbox",
    "env:sandbox": "echo 'Run bun sst dev, then type env:sandbox in the SST dev UI'",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "knip": "knip",
    "knip:backend": "knip -W services/backend --include classMembers",
    "lint": "biome lint . && bun run lint:comments && bun run check:i18n-types && bun run check:ios-floor && bun run check:ios-url-scheme && bun run check:android-manifest && bun run check:publishable && bun run check:safe-area",
    "lint:comments": "bun scripts/check-comments.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:apps": "vitest run --project *-unit",
    "test:sdk": "vitest run --project core-sdk-unit --project react-sdk-unit --project components-sdk-unit",
    "update:deps": "npm-check-updates -ui -ws",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "sdk/*",
      "example/*",
      "services/*"
    ]
  },
  "catalog": {
    "viem": "^2.56.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3",
    "zustand": "^5.0.15",
    "wagmi": "^3.7.7",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-query-persist-client": "5.102.8",
    "@tanstack/query-async-storage-persister": "5.102.8",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/query-persist-client-core": "5.102.8",
    "@tanstack/query-sync-storage-persister": "5.102.8",
    "vite": "^8.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tsdown": "^0.22.14",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "rolldown": "~1.2.0",
    "@openpanel/web": "^1.4.1",
    "sst": "4.14.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vanilla-extract/integration": "^8.0.10",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "vitest": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "@types/jsdom": "^30.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/preact": "^3.2.4",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-for-ts": "^2.1.0",
    "lucide-react": "^1.43.0",
    "clsx": "^2.1.1",
    "sonner": "^2.0.8",
    "preact": "^10.29.8",
    "@preact/preset-vite": "^2.10.6",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/router-generator": "1.167.34",
    "@tanstack/router-plugin": "1.168.36",
    "@tanstack/react-router-devtools": "1.167.1",
    "ox": "^0.14.44",
    "permissionless": "^0.3.7",
    "radash": "^12.1.1",
    "qr": "^0.7.0",
    "idb-keyval": "^6.3.0",
    "@elysiajs/eden": "^1.4.9",
    "vite-plugin-remove-console": "^2.2.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.12",
    "elysia": "1.4.29",
    "nanoid": "^6.0.1",
    "@tanstack/react-table": "^8.21.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "react-hook-form": "^7.87.0",
    "remix-utils": "^9.3.1",
    "vite-plugin-mkcert": "^2.1.0",
    "@noble/curves": "^2.4.0"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001810",
    "vite": "catalog:"
  },
  "resolutions": {
    "@testing-library/dom": "^10.4.1"
  },
  "trustedDependencies": []
}

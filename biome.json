{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/_cjs",
            "!**/_esm",
            "!**/_types",
            "!**/.build",
            "!**/.claude",
            "!**/tsconfig.json",
            "!**/tsconfig.*.json",
            "!**/package.json",
            "!example/vanilla-js/index.html",
            "!**/routeTree.gen.ts",
            "!services/backend/user-openapi.json",
            "!sdk/core/src/**/fixtures/*.json",
            "!**/types/i18n/resources.d.ts",
            "!**/src-tauri/gen",
            "!sdk/android",
            "!sdk/ios",
            "!example/native-android",
            "!example/native-ios",
            "!**/src-tauri/plugins/**/schema.json",
            "!plugins",
            "!apps/shopify/**/shopify.d.ts"
        ]
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "html": {
        "formatter": {
            "enabled": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noExcessiveCognitiveComplexity": {
                    "level": "error",
                    "options": {
                        "maxAllowedComplexity": 16
                    }
                },
                "noUselessTernary": "error",
                "noImportantStyles": "off"
            },
            "correctness": {
                "useHookAtTopLevel": "error",
                "noUnusedVariables": {
                    "level": "error",
                    "options": {
                        "ignoreRestSiblings": true
                    }
                },
                "noUnusedImports": "error",
                "noUndeclaredVariables": "off",
                "noUnusedPrivateClassMembers": "error"
            },
            "style": {
                "useFragmentSyntax": "error",
                "useShorthandAssign": "error",
                "useImportType": "error",
                "useExportType": "error",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                },
                "noDescendingSpecificity": "off"
            },
            "a11y": {
                "noStaticElementInteractions": "off"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            },
            "suspicious": {
                "noDuplicateProperties": "off",
                "noDocumentCookie": "off",
                "noUnknownAtRules": "off"
            },
            "performance": {
                "noImgElement": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.spec.ts",
                "**/*.spec.tsx"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        },
        {
            "includes": ["apps/listener/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "@frak-labs/wallet-shared": "Listener is loaded on every partner page. Use a domain subpath (@frak-labs/wallet-shared/common, /pairing, /sharing, /stores/<store>) instead — the bare barrel re-exports ./blockchain, ./providers, ./wallet which forces blockchain-vendor into the eager iframe bundle."
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/test-foundation/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/design-system/src/components/charts/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**",
                "!apps/wallet/**",
                "!apps/listener/**",
                "!packages/wallet-shared/**",
                "!sdk/react/tests/**"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "@frak-labs/wallet-shared",
                                            "@frak-labs/wallet-shared/**"
                                        ],
                                        "message": "@frak-labs/wallet-shared is scoped to the wallet and listener apps (apps/wallet, apps/listener), plus the package itself and sdk/react/tests for shared fixtures. No other workspace may import it — extract the shared logic into a package with a broader audience (@frak-labs/design-system, @frak-labs/core-sdk, ...) instead of widening this allowlist."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    ],
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "es5"
        }
    },
    "css": {
        "linter": {
            "enabled": true
        },
        "formatter": {
            "enabled": true
        }
    }
}

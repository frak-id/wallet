<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Declared empty at the app level. The SDK behind this harness does persist and
  send data, and ships its own PrivacyInfo.xcprivacy describing it — an app-level
  manifest does not restate a dependency's. Revisit if the harness itself ever
  touches a required-reason API directly.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyTracking</key>
    <false/>
</dict>
</plist>

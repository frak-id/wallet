<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No <queries> or INTERNET permission here: `:frak-sdk`'s own manifest already declares
      both, and the manifest merger folds them into this one automatically.
    -->

    <application
        android:allowBackup="false"
        android:label="Frak Merchant Example"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Inbound referral links. No android:autoVerify: example-merchant.com is a
              placeholder domain with no assetlinks.json, so verification would fail and
              the link opens in a browser instead. A real merchant sets autoVerify and
              publishes asset links for their own domain.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="example-merchant.com"
                    android:pathPrefix="/product" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="merchantapp" />
            </intent-filter>
        </activity>

    </application>

</manifest>

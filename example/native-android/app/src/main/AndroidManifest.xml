<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No <queries> and no INTERNET permission declared here: `:frak-sdk`'s own manifest already
      declares both (id.frak.wallet / id.frak.wallet.dev app-detection queries, and INTERNET),
      and the manifest merger folds a dependency's manifest into this one automatically. Repeating
      them here was dead duplication once this app actually depended on the SDK — two places to
      keep in sync for no gain, exactly the reasoning frak-sdk-ui's own manifest gives for not
      repeating them either.
    -->

    <application
        android:allowBackup="false"
        android:label="Frak Merchant Example"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Inbound referral links.

              No `android:autoVerify="true"` on the https filter: `example-merchant.com`
              is a placeholder we do not control and it serves no `assetlinks.json`,
              so verification would simply fail at install time and the link would
              open in a browser. A real merchant sets autoVerify and publishes the
              asset links file for their own domain.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="example-merchant.com"
                    android:pathPrefix="/product" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="merchantapp" />
            </intent-filter>
        </activity>

    </application>

</manifest>

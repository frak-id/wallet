<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Frak wallet app detection — strictly scoped, never QUERY_ALL_PACKAGES
      (Play policy restricts it to apps whose core purpose needs broad
      visibility; requesting it drags every integrator into a Permissions
      Declaration review).

      Both variants are listed: the wallet ships as `id.frak.wallet` in prod and
      `id.frak.wallet.dev` for the dev stage (see
      `packages/wallet-shared/src/common/utils/storeUrls.ts`). Querying only the
      prod package makes a locally-built dev wallet undetectable — exactly the
      build a POC runs against.
    -->
    <queries>
        <package android:name="id.frak.wallet" />
        <package android:name="id.frak.wallet.dev" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Frak Merchant Example"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Inbound referral links.

              No `android:autoVerify="true"` on the https filter: `example-merchant.com`
              is a placeholder we do not control and it serves no `assetlinks.json`,
              so verification would simply fail at install time and the link would
              open in a browser. A real merchant sets autoVerify and publishes the
              asset links file for their own domain.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="example-merchant.com"
                    android:pathPrefix="/product" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="merchantapp" />
            </intent-filter>
        </activity>

    </application>

</manifest>
